#!/bin/sh
# deb postinst: 安装后零配置可用
# 兼容性设计（单一 deb 适配全部发行版/全新系统）:
#   1) 目标用户不依赖 SUDO_USER（GUI 软件中心安装时为空），扫描全部真实用户；
#      也不要求用户已有 fcitx5 配置（全新 OS 上 profile 尚未生成也要能配置）。
#   2) 已有 profile: 追加 lufly 进分组并设默认；无 profile: 直接创建含 lufly 的
#      最小 profile（fcitx5 首启即可选到小鹭）。
#   3) theme/classicui/config 的键名在 fcitx5 5.0.x ~ master 均稳定存在；
#      主题缺失时 fcitx5 静默回退内置默认样式，所以 theme.conf 必须随包装好。
# fcitx5 监听 profile 文件变化，运行中即生效；classicui 主题需重启 fcitx5。
set -e

# 找到目标用户: 优先本次安装的调用者，其次所有真实用户（uid>=1000 且家目录在 /home）
USERS=""
if [ -n "${SUDO_USER:-}" ]; then
    USERS="$SUDO_USER"
fi
for u in $(getent passwd | awk -F: '$3 >= 1000 && $6 ~ /^\/home\// {print $1}'); do
    case " $USERS " in
        *" $u "*) continue ;;
    esac
    USERS="$USERS $u"
done

# 用户目录的主题是早期调试残留，XDG 用户目录优先级高于系统目录，
# 不清掉会一直覆盖 deb 安装的新版主题
rm -rf /home/*/.local/share/fcitx5/themes/lufly \
       /home/*/.local/share/fcitx5/themes/lufly-dark \
       /home/*/.local/share/fcitx5/themes/lufly-flat 2>/dev/null || true

for u in $USERS; do
    HOME_DIR=$(getent passwd "$u" | cut -d: -f6)
    [ -n "$HOME_DIR" ] || continue
    OWNER=$(stat -c '%U:%G' "$HOME_DIR" 2>/dev/null || echo "$u")

    # 1) 选中「小鹭」主题并跟随系统深浅色（classicui.conf 无节头，平铺键值）
    C_DIR="$HOME_DIR/.config/fcitx5/conf"
    C="$C_DIR/classicui.conf"
    MADE_DIR=0
    if [ ! -d "$C_DIR" ]; then
        mkdir -p "$C_DIR"
        MADE_DIR=1
    fi
    python3 - "$C" <<'PYEOF' || true
import os, sys

path = sys.argv[1]
want = {
    "Theme": "lufly",
    "DarkTheme": "lufly-dark",
    "UseDarkTheme": "True",
    "Font": "Noto Sans CJK SC 11",
}
lines = open(path, encoding="utf-8").read().splitlines() if os.path.exists(path) else []
seen = set()
out = []
for ln in lines:
    key = ln.split("=", 1)[0].strip() if "=" in ln else None
    if key in want:
        if key not in seen:
            out.append(f"{key}={want[key]}")
            seen.add(key)
        continue
    out.append(ln)
for key, val in want.items():
    if key not in seen:
        out.append(f"{key}={val}")
open(path, "w", encoding="utf-8").write("\n".join(out) + "\n")
print("fcitx5-lufly: 主题已设为「小鹭」（跟随系统深浅色）")
PYEOF
    chown "$OWNER" "$C"
    if [ "$MADE_DIR" = 1 ]; then
        chown "$OWNER" "$C_DIR"
        if [ "$(stat -c '%U' "$HOME_DIR/.config/fcitx5")" = "root" ]; then
            chown "$OWNER" "$HOME_DIR/.config/fcitx5"
        fi
    fi

    # 2) 打开「在程序中显示预编辑文本」，编码字母内联显示在光标后
    G_DIR="$HOME_DIR/.config/fcitx5"
    G="$G_DIR/config"
    python3 - "$G_DIR" "$G" <<'PYEOF' || true
import os, sys

cfg_dir, path = sys.argv[1], sys.argv[2]
os.makedirs(cfg_dir, exist_ok=True)
lines = open(path, encoding="utf-8").read().splitlines() if os.path.exists(path) else []
out, in_behavior, done = [], False, False
for ln in lines:
    if ln.strip() == "[Behavior]":
        in_behavior = True
        out.append(ln)
        continue
    if ln.strip().startswith("[") and in_behavior:
        if not done:
            out.append("PreeditEnabledByDefault=True")
            done = True
        in_behavior = False
    if in_behavior and ln.strip().startswith("PreeditEnabledByDefault"):
        if not done:
            out.append("PreeditEnabledByDefault=True")
            done = True
        continue
    out.append(ln)
if in_behavior and not done:
    out.append("PreeditEnabledByDefault=True")
    done = True
elif not done:
    out.append("")
    out.append("[Behavior]")
    out.append("PreeditEnabledByDefault=True")
open(path, "w", encoding="utf-8").write("\n".join(out) + "\n")
PYEOF
    chown "$OWNER" "$G"
    if [ "$(stat -c '%U' "$G_DIR")" = "root" ]; then
        chown "$OWNER" "$G_DIR"
    fi

    # 3) 输入法分组: 已有 profile 则追加 lufly 并设默认；没有则创建最小 profile
    #    （全新 OS 上 profile 尚不存在，旧逻辑直接跳过导致用户要手动加输入法）
    P="$HOME_DIR/.config/fcitx5/profile"
    if [ ! -f "$P" ]; then
        cat > "$P" <<EOF
[Groups/0]
# Name
Name=Default
# Layout
Default Layout=us
# Default Input Method
DefaultIM=lufly

[Groups/0/Items/0]
# Name
Name=keyboard-us
# Layout
Layout=

[Groups/0/Items/1]
# Name
Name=lufly
# Layout
Layout=

[GroupOrder]
0=Default
EOF
        chown "$OWNER" "$P"
        echo "fcitx5-lufly: 已为 $u 创建默认输入法分组（含小鹭音形）"
    else
        OWNER_P=$(stat -c '%U:%G' "$P")
        python3 - "$P" <<'PYEOF' || true
import re, sys

path = sys.argv[1]
text = open(path, encoding="utf-8").read()
changed = False

# 每个分组的最大 Items 序号
maxitem = {}
for m in re.finditer(r"(?m)^\[Groups/(\d+)/Items/(\d+)\]", text):
    g, i = int(m.group(1)), int(m.group(2))
    maxitem[g] = max(maxitem.get(g, -1), i)

# 1) 尚未注册时: 在每个分组最后一个 item 节后追加 lufly
if maxitem and not re.search(r"(?m)^Name=lufly$", text):
    sections = text.split("\n\n")
    for idx, sec in enumerate(sections):
        m = re.search(r"(?m)^\[Groups/(\d+)/Items/(\d+)\]", sec)
        if m and int(m.group(2)) == maxitem[int(m.group(1))]:
            g = int(m.group(1))
            sections[idx] = (
                sec
                + f"\n\n[Groups/{g}/Items/{maxitem[g] + 1}]"
                + "\n# Name\nName=lufly\n# Layout\nLayout="
            )
    text = "\n\n".join(sections)
    changed = True

# 2) 含 lufly 的分组 DefaultIM 指向小鹭（新窗口默认小鹭，而非 rime）
#    两遍扫描: 先收集含 lufly 的分组号（DefaultIM 行在其 Items 节之前出现）
if maxitem:
    lufly_groups = {
        int(m.group(1))
        for m in re.finditer(r"(?m)^\[Groups/(\d+)/Items/\d+\]\n# Name\nName=lufly\b", text)
    }
    out = []
    cur_group = None
    for ln in text.splitlines():
        s = ln.strip()
        gm = re.match(r"^\[Groups/(\d+)\]$", s)
        if gm:
            cur_group = int(gm.group(1))
        if s.startswith("DefaultIM=") and cur_group in lufly_groups:
            if s != "DefaultIM=lufly":
                ln = "DefaultIM=lufly"
                changed = True
        out.append(ln)
    text = "\n".join(out)

if changed:
    open(path, "w", encoding="utf-8").write(text + "\n")
    print("fcitx5-lufly: 已把「小鹭音形」加入输入法列表并设为默认")
PYEOF
        chown "$OWNER_P" "$P"
    fi

    # classicui.conf 不是热加载，fcitx5 运行中装完需要重启才换肤
    if pgrep -u "$u" -x fcitx5 >/dev/null 2>&1; then
        echo "fcitx5-lufly: $u 的 fcitx5 正在运行，重启 fcitx5 后主题生效"
    fi

    # GNOME 的 kimpanel 扩展接管候选窗时（fcitx5 检测到 org.kde.kimpanel 总线即让位），
    # ClassicUI 与小鹭主题完全不参与渲染，表现为黑底+系统强调色药丸的 GNOME 样式。
    # 检测到就给出禁用指引（仅提示，不代用户改系统设置）。
    # 注意 runuser 不会继承用户会话环境，必须显式给 DBUS_SESSION_BUS_ADDRESS，
    # 否则 gnome-extensions 连不上总线静默失败（26.04 实测教训）。
    if command -v runuser >/dev/null 2>&1 && command -v gnome-extensions >/dev/null 2>&1; then
        UID_N=$(id -u "$u" 2>/dev/null || true)
        if [ -n "$UID_N" ] && [ -S "/run/user/$UID_N/bus" ]; then
            KIMPANEL=$(runuser -u "$u" -- env \
                XDG_RUNTIME_DIR="/run/user/$UID_N" \
                DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UID_N/bus" \
                gnome-extensions list --enabled 2>/dev/null | grep -i kimpanel || true)
            if [ -n "$KIMPANEL" ]; then
                echo "fcitx5-lufly: 检测到 GNOME kimpanel 扩展（$KIMPANEL）在接管候选窗渲染，"
                echo "fcitx5-lufly: 如需使用小鹭主题，请执行: gnome-extensions disable \"$KIMPANEL\" 并重启 fcitx5"
            fi
        fi
    fi
done

# 刷新图标缓存（失败不阻塞安装）
update-icon-caches /usr/share/icons/hicolor 2>/dev/null || true

echo "fcitx5-lufly: 安装完成。Ctrl+Space 切换输入法即可选到「小鹭音形」。"
exit 0
